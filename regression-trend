    # Friendly display labels for the bucket buttons.
    #   month: "2026-04"   → "Apr 2026"
    #   week:  "2026-04-26" (the Sunday) → "Sun Apr 26 — Sat May 2"
    #   day:   "2026-04-26"                → "Sun Apr 26"
    def _pretty_bucket(label: str, bucket_kind: str) -> str:
        if bucket_kind == "month":
            try:
                return datetime.strptime(label + "-01", "%Y-%m-%d").strftime("%b %Y")
            except ValueError:
                return label
        if bucket_kind == "day":
            try:
                return datetime.strptime(label, "%Y-%m-%d").strftime("%a %b %d")
            except ValueError:
                return label
        try:
            sun = datetime.strptime(label, "%Y-%m-%d")
            sat = sun + timedelta(days=6)
            return f"{sun.strftime('%b %d')} – {sat.strftime('%b %d')}"
        except ValueError:
            return label

    import json as _json

