    resolved_div = ""
    if resolved_fig is not None:
        resolved_div = resolved_fig.to_html(
            include_plotlyjs=False,
            full_html=False,
            div_id="chart-resolved",
            config={"displaylogo": False, "responsive": True},
        )

    crash_div = ""
    if crash_fig is not None:
        crash_div = crash_fig.to_html(
            include_plotlyjs=False,
            full_html=False,
            div_id="chart-crashes",
            config={"displaylogo": False, "responsive": True},
        )

    html_doc = """<!DOCTYPE html>
