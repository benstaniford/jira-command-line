#!/usr/bin/env python3
"""
Regression Trend - Graphs nightly Run Regression pass rates over N weeks.

Pulls data from the BeyondTrust DevOps Portal (portal.btrusteng.com) which
aggregates results from GitHub Actions runs. Produces a PNG chart and prints
a summary table with links to each run, plus an optional flakey-test report.

Replaces the old Azure DevOps integration. Build IDs are now GitHub Actions
run IDs and link to https://github.com/<owner>/<repo>/actions/runs/<id>.
"""

import argparse
import os
import sys
import requests
from collections import defaultdict
from datetime import datetime, timedelta, timezone
from typing import List, Dict, Any

DEFAULT_PORTAL_URL = "https://portal.btrusteng.com"
DEFAULT_REPO = "epm-windows"
DEFAULT_WORKFLOW = "Run Regression"
DEFAULT_BRANCH = "main"
GITHUB_OWNER = "BeyondTrust"


class PortalConnection:
    """Handles BeyondTrust DevOps Portal API connection and requests."""

    def __init__(self, portal_url: str, repo: str, workflow: str, branch: str):
        self.portal_url = portal_url.rstrip("/")
        self.repo = repo
        self.workflow = workflow
        self.branch = branch

        self.session = requests.Session()
        self.session.headers.update({"Accept": "application/json"})
        self.session.verify = False  # Internal portal — self-signed cert tolerated

    def make_request(self, path: str, params: Dict[str, Any] = None) -> Any:
        url = f"{self.portal_url}{path}"
        response = self.session.get(url, params=params, timeout=180)
        response.raise_for_status()
        return response.json()

    def get_test_trends(self, days: int) -> List[Dict[str, Any]]:
        """Get per-build trend points for the configured workflow on the configured branch."""
        data = self.make_request(
            "/ReportData/GetTestTrends",
            params={"workflow": self.workflow, "repo": self.repo, "days": days},
        )
        return data.get("points") or []

    def get_build_summary(self, build_id: str) -> Dict[str, Any]:
        """Get a one-call dashboard aggregate for a build, including all failures."""
        return self.make_request(
            "/ReportData/GetBuildSummary",
            params={"buildId": build_id},
        )

    def get_build_web_url(self, build_id: str) -> str:
        """GitHub Actions run URL for a build."""
        return f"https://github.com/{GITHUB_OWNER}/{self.repo}/actions/runs/{build_id}"


def parse_time(time_str: str) -> datetime:
    """Parse a portal timestamp (ISO 8601 with offset) to a UTC datetime."""
    if not time_str:
        return None
    # Python 3.11+ fromisoformat handles offsets and fractional seconds.
    dt = datetime.fromisoformat(time_str)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=timezone.utc)
    return dt.astimezone(timezone.utc)


def collect_data(conn: PortalConnection, days: int) -> List[Dict[str, Any]]:
    """Fetch trend points and shape them into the result dicts used downstream."""
    print(f"Fetching trend for {conn.workflow!r} on {conn.branch!r} "
          f"({conn.repo}) over {days} day(s)...", file=sys.stderr)

    points = conn.get_test_trends(days)
    print(f"Portal returned {len(points)} build point(s)", file=sys.stderr)

    results = []
    for p in points:
        build_id = p.get("buildId")
        if not build_id:
            continue
        start_time = parse_time(p.get("startTime"))
        if start_time is None:
            continue

        passed = int(p.get("passed") or 0)
        failed = int(p.get("failed") or 0)
        total = int(p.get("testCount") or 0)
        # Treat notExecuted + otherOutcomes as "other" so the calculation
        # matches the legacy script: passed / (passed + failed + other).
        other = max(0, total - passed - failed)
        pass_pct = (passed / total * 100) if total > 0 else 0

        results.append({
            "build_id": build_id,
            "build_number": p.get("buildNumber") or "",
            "date": start_time,
            "url": conn.get_build_web_url(build_id),
            "passed": passed,
            "failed": failed,
            "other": other,
            "total": total,
            "pass_pct": pass_pct,
            "state": p.get("state") or "",
        })

    results.sort(key=lambda r: r["date"])
    return results


def print_table(results: List[Dict[str, Any]]):
    """Print a summary table to stdout."""
    if not results:
        print("No regression runs found in the requested window.")
        return

    print(f"{'Date':<12} {'Pass%':>6} {'Passed':>7} {'Failed':>7} {'Other':>7} "
          f"{'Total':>7}  {'Build':<20}  URL")
    print("-" * 140)

    for r in results:
        date_str = r["date"].strftime("%Y-%m-%d")
        build = (r["build_number"] or "")[:20]
        print(f"{date_str:<12} {r['pass_pct']:>5.1f}% {r['passed']:>7} {r['failed']:>7} "
              f"{r['other']:>7} {r['total']:>7}  {build:<20}  {r['url']}")

    print("-" * 140)
    avg_pct = sum(r["pass_pct"] for r in results) / len(results)
    print(f"{'Average':<12} {avg_pct:>5.1f}%")


def generate_chart(results: List[Dict[str, Any]], output_path: str,
                   duration_label: str):
    """Generate a PNG chart of pass percentage over time."""
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    import matplotlib.dates as mdates

    if not results:
        print("No data to chart.", file=sys.stderr)
        return

    dates = [r["date"] for r in results]
    pass_pcts = [r["pass_pct"] for r in results]

    fig, ax1 = plt.subplots(figsize=(14, 6))

    color_pass = "#2ecc71"
    color_fail = "#e74c3c"

    ax1.plot(dates, pass_pcts, "o-", color=color_pass, linewidth=2,
             markersize=8, label="Pass %", zorder=3)
    ax1.fill_between(dates, pass_pcts, alpha=0.15, color=color_pass)
    ax1.axhline(y=100, color="#95a5a6", linestyle="--", linewidth=1, alpha=0.5)

    ax1.set_xlabel("Date", fontsize=12)
    ax1.set_ylabel("Pass Rate (%)", fontsize=12)
    ax1.set_title(f"Run Regression Nightly Pass Rate (main branch, last "
                  f"{duration_label})", fontsize=14, fontweight="bold")

    ax1.set_ylim(bottom=max(0, min(pass_pcts) - 5), top=101)
    ax1.xaxis.set_major_formatter(mdates.DateFormatter("%m-%d"))
    ax1.xaxis.set_major_locator(mdates.DayLocator(interval=max(1, len(dates) // 10)))
    fig.autofmt_xdate()

    ax1.grid(True, alpha=0.3)
    ax1.legend(loc="lower left", fontsize=10)

    ax2 = ax1.twinx()
    bar_width = 0.5
    passed_counts = [r["passed"] for r in results]
    failed_counts = [r["failed"] for r in results]

    ax2.bar(dates, passed_counts, width=bar_width, alpha=0.25, color=color_pass,
            label="Passed")
    ax2.bar(dates, failed_counts, width=bar_width, bottom=passed_counts,
            alpha=0.25, color=color_fail, label="Failed")
    ax2.set_ylabel("Test Count", fontsize=12)
    ax2.legend(loc="lower right", fontsize=10)

    plt.tight_layout()
    plt.savefig(output_path, dpi=150, bbox_inches="tight")
    print(f"Chart saved to {output_path}", file=sys.stderr)


import re as _re

# Matches crash-dump filenames referenced in teardown exception text, e.g.
# "DefendpointService.exe_260601_064524.dmp".
_DMP_RE = _re.compile(r"[A-Za-z0-9_.\-]+\.dmp", _re.IGNORECASE)


def _outcome_str(f: Dict[str, Any]) -> str:
    """Normalise a failure entry's outcome (plain string or enum object)."""
    outcome = f.get("outcome")
    if isinstance(outcome, str):
        return outcome
    if isinstance(outcome, dict):
        return outcome.get("value") or ""
    return ""


def fetch_failure_map(conn: PortalConnection,
                      results: List[Dict[str, Any]]
                      ) -> "tuple[Dict[str, List[Dict[str, Any]]], Dict[str, Dict[str, int]]]":
    """Walk builds once and return (failure_map, crash_per_build).

    failure_map:     {test_name: [{date, suite, build_id}, ...]} for Failed tests.
    crash_per_build: {build_id: {total, machines, failed, passed}} where
        - total    = build-level crashDumpCount (authoritative dump volume)
        - machines = crashDumpMachineCount
        - failed   = distinct .dmp files named in a Failed test's teardown
                     exception (a crash that took a test down with it)
        - passed   = total - failed (dumps not attributed to a failed test —
                     i.e. a crash was detected but its test still passed / the
                     dump wasn't tied to a specific failure). Clamped to >= 0.
    """
    import time as _time

    failure_map = defaultdict(list)
    crash_per_build: Dict[str, Dict[str, int]] = {}

    for i, r in enumerate(results):
        build_id = r["build_id"]
        date_str = r["date"].strftime("%Y-%m-%d")

        print(f"  [{i+1}/{len(results)}] Fetching failures for build {build_id} "
              f"({date_str})...", file=sys.stderr)

        # Retry once on transient network failures (portal timeouts are common
        # on heavier builds). Skip the build if both attempts fail rather than
        # crashing the whole report.
        summary = None
        last_err = None
        for attempt in range(2):
            try:
                summary = conn.get_build_summary(build_id)
                break
            except requests.exceptions.RequestException as e:
                last_err = e
                if attempt == 0:
                    print(f"    Retry after error: {type(e).__name__}: {e}",
                          file=sys.stderr)
                    _time.sleep(2)
        if summary is None:
            print(f"    Skipped after retry: {last_err}", file=sys.stderr)
            continue

        # Dumps that took a test down: collect distinct (endpoint, dump-file)
        # pairs named in Failed tests' teardown exceptions. Keying on endpoint
        # too avoids collapsing identically-named dumps from different machines.
        failed_dump_keys = set()
        for f in summary.get("failures") or []:
            outcome_str = _outcome_str(f)
            if outcome_str != "Failed":
                continue

            test_name = f.get("testName") or "Unknown"
            suite = f.get("executionDefinition") or "Unknown"
            failure_map[test_name].append({
                "date": date_str,
                "suite": suite,
                "build_id": build_id,
            })

            exc = f.get("exception")
            if exc:
                endpoint = f.get("endpointName") or ""
                for dmp in _DMP_RE.findall(str(exc)):
                    failed_dump_keys.add((endpoint, dmp))

        total_dumps = int(summary.get("crashDumpCount") or 0)
        machines = int(summary.get("crashDumpMachineCount") or 0)
        # Can't attribute more dumps to failures than the build actually has.
        failed_dumps = min(len(failed_dump_keys), total_dumps)
        crash_per_build[build_id] = {
            "total": total_dumps,
            "machines": machines,
            "failed": failed_dumps,
            "passed": max(0, total_dumps - failed_dumps),
        }

    return failure_map, crash_per_build


def collect_flakey_data(conn: PortalConnection, results: List[Dict[str, Any]],
                        full_detail: int) -> None:
    """Walk each remaining build, pull failures, and write flakey.md."""
    failure_map, _ = fetch_failure_map(conn, results)

    if not failure_map:
        print("No failed tests found across the selected runs.", file=sys.stderr)
        return

    # Sort by frequency descending, then alphabetically.
    sorted_tests = sorted(failure_map.items(), key=lambda x: (-len(x[1]), x[0]))

    total_runs = len(results)
    date_range_start = results[0]["date"].strftime("%Y-%m-%d")
    date_range_end = results[-1]["date"].strftime("%Y-%m-%d")

    lines = []
    lines.append("# Flakey Regression Tests")
    lines.append("")
    lines.append(f"Period: **{date_range_start}** to **{date_range_end}** "
                 f"({total_runs} nightly runs)")
    lines.append("")
    lines.append("| # | Failures | Rate | Test | Suite(s) | Dates |")
    lines.append("|---|----------|------|------|----------|-------|")

    for rank, (test_name, occurrences) in enumerate(sorted_tests, 1):
        count = len(occurrences)
        rate = f"{count}/{total_runs}"
        pct = count / total_runs * 100
        suites = sorted(set(o["suite"] for o in occurrences))
        suites_str = ", ".join(suites)
        dates = sorted(set(o["date"] for o in occurrences))
        dates_str = ", ".join(dates)
        lines.append(f"| {rank} | {count} ({pct:.0f}%) | {rate} | {test_name} | "
                     f"{suites_str} | {dates_str} |")

    top_n = min(full_detail, len(sorted_tests))
    lines.append("")
    lines.append("---")
    lines.append("")
    lines.append(f"## Top {top_n} Flakey Tests — Regression Run Links")
    lines.append("")

    for rank, (test_name, occurrences) in enumerate(sorted_tests[:top_n], 1):
        count = len(occurrences)
        pct = count / total_runs * 100
        lines.append(f"### {rank}. {test_name} ({count} failures, {pct:.0f}%)")
        lines.append("")
        for o in sorted(occurrences, key=lambda x: x["date"]):
            url = conn.get_build_web_url(o["build_id"])
            lines.append(f"- {o['date']} — [{o['suite']}]({url})")
        lines.append("")

    lines.append(f"*Generated {datetime.now(timezone.utc).strftime('%Y-%m-%d %H:%M UTC')}*")
    lines.append("")

    output_path = "flakey.md"
    with open(output_path, "w") as f:
        f.write("\n".join(lines))

    print(f"\nWrote {len(sorted_tests)} flakey tests to {output_path}", file=sys.stderr)


def bucket_key(date: datetime, bucket: str) -> str:
    """Return a stable label for the time bucket containing this date."""
    if bucket == "month":
        return date.strftime("%Y-%m")
    if bucket == "day":
        return date.strftime("%Y-%m-%d")
    # Sunday-start week (Sun → Sat). The label is the ISO date of that Sunday,
    # so labels sort chronologically as plain strings.
    # Python weekday(): Mon=0 … Sun=6 → days since Sunday = (weekday + 1) % 7.
    days_since_sun = (date.weekday() + 1) % 7
    sunday = date - timedelta(days=days_since_sun)
    return sunday.strftime("%Y-%m-%d")


def bucket_anchor(label: str, bucket: str) -> datetime:
    """Return a datetime anchor (UTC) for a bucket label, used for plotting."""
    if bucket == "month":
        return datetime.strptime(label + "-01", "%Y-%m-%d").replace(tzinfo=timezone.utc)
    # Week label is the Sunday's date in YYYY-MM-DD form; day label is the date itself.
    return datetime.strptime(label, "%Y-%m-%d").replace(tzinfo=timezone.utc)


def generate_interactive_html(conn: PortalConnection,
                              results: List[Dict[str, Any]],
                              failure_map: Dict[str, List[Dict[str, Any]]],
                              output_path: str,
                              duration_label: str,
                              bucket: str,
                              top_n: int = 30,
                              min_failures: int = 1,
                              max_failure_rate: float = 0.95,
                              min_pass_rate: float = 0.0,
                              exclude_prefixes: List[str] = None,
                              exclude_suite_substrings: List[str] = None,
                              crash_per_build: Dict[str, Dict[str, int]] = None) -> None:
    """Render an interactive Plotly HTML report (pass rate + flaky-test trend)."""
    crash_per_build = crash_per_build or {}
    try:
        import plotly.graph_objects as go
        from plotly.subplots import make_subplots
    except ImportError:
        print("Plotly is not installed. Run: pip install plotly", file=sys.stderr)
        sys.exit(1)

    # --- Per-build pass-rate trace ---
    run_dates = [r["date"] for r in results]
    pass_pcts = [r["pass_pct"] for r in results]
    passed_counts = [r["passed"] for r in results]
    failed_counts = [r["failed"] for r in results]
    build_urls = [r["url"] for r in results]
    hover_text = [
        f"<b>{r['date'].strftime('%Y-%m-%d')}</b><br>"
        f"Pass: {r['pass_pct']:.1f}% ({r['passed']}/{r['total']})<br>"
        f"Failed: {r['failed']}<br>"
        f"<a href='{r['url']}'>open run</a>"
        for r in results
    ]

    # --- Apply filters before any further work. ---
    # Tests below the thresholds are dropped from failure_map so every downstream
    # computation (top-N ranking, Other rollup, unique-per-bucket, view payload)
    # only sees qualifying tests.
    original_test_count = len(failure_map)
    total_runs = len(results)
    exclude_prefixes = list(exclude_prefixes or [])
    exclude_suite_substrings = list(exclude_suite_substrings or [])

    # -1) --exclude-suite: drop individual failure occurrences whose suite name
    #     contains any given substring (case-insensitive). Applied before any
    #     per-test math so failure counts, top-N ranking, and the bracket chart
    #     reflect only the kept occurrences. Tests whose entire failure history
    #     was on the excluded suite are dropped here too.
    dropped_suite_occurrences = 0
    dropped_suite_tests = 0
    if exclude_suite_substrings:
        suite_subs_lc = [s.lower() for s in exclude_suite_substrings]
        new_failure_map: Dict[str, List[Dict[str, Any]]] = {}
        for test_name, occurrences in failure_map.items():
            kept = []
            for occ in occurrences:
                suite_lc = (occ.get("suite") or "").lower()
                if any(p in suite_lc for p in suite_subs_lc):
                    dropped_suite_occurrences += 1
                else:
                    kept.append(occ)
            if kept:
                new_failure_map[test_name] = kept
            else:
                dropped_suite_tests += 1
        failure_map = new_failure_map

    # 0) --exclude-prefix: drop tests whose name begins with any of the given
    #    prefixes. Applied first so all downstream counts reflect the exclusion.
    excluded_by_prefix: List[str] = []
    if exclude_prefixes:
        excluded_by_prefix = [
            n for n in failure_map.keys()
            if any(n.startswith(p) for p in exclude_prefixes)
        ]
        if excluded_by_prefix:
            failure_map = {
                n: occ for n, occ in failure_map.items()
                if n not in set(excluded_by_prefix)
            }

    # 1) --max-failure-rate: drop consistently-broken tests. We approximate
    #    pass-rate using (total_runs - failures) since we don't have per-test
    #    pass counts. Assumes the test ran in every build, which is the case
    #    for a regression suite but not always exact.
    dropped_broken_names: List[str] = []
    if max_failure_rate < 1.0 and total_runs > 0:
        dropped_broken_names = [
            n for n, occ in failure_map.items()
            if (len(occ) / total_runs) >= max_failure_rate
        ]
        if dropped_broken_names:
            failure_map = {
                n: occ for n, occ in failure_map.items()
                if n not in set(dropped_broken_names)
            }

    # 2) --min-failures: drop tests with too few failures to be interesting.
    if min_failures > 1:
        failure_map = {
            n: occ for n, occ in failure_map.items() if len(occ) >= min_failures
        }

    # --- Bucketed flake data ---
    # Total failures per test (bucket-independent) — used for ranking and the
    # top-N / Other split. Both Week and Month views share the same ranking.
    test_totals = {
        test_name: len(occurrences) for test_name, occurrences in failure_map.items()
    }
    tests_ranked_names = sorted(
        test_totals.keys(), key=lambda n: (-test_totals[n], n)
    )
    if top_n and len(tests_ranked_names) > top_n:
        top_test_names = tests_ranked_names[:top_n]
        other_test_names = tests_ranked_names[top_n:]
    else:
        top_test_names = tests_ranked_names
        other_test_names = []
    top_test_set = set(top_test_names)
    other_test_set = set(other_test_names)

    def _compute_view(bucket_kind: str) -> Dict[str, Any]:
        """Bucket-dependent data for a single view (week or month)."""
        run_bucket = {
            r["build_id"]: bucket_key(r["date"], bucket_kind) for r in results
        }
        labels = sorted(set(run_bucket.values()))
        anchors = [bucket_anchor(b, bucket_kind) for b in labels]

        per_test: Dict[str, Dict[str, int]] = defaultdict(lambda: defaultdict(int))
        for test_name, occurrences in failure_map.items():
            for o in occurrences:
                b = run_bucket.get(o["build_id"])
                if b is not None:
                    per_test[test_name][b] += 1

        unique_pb = {b: 0 for b in labels}
        for _, by_bucket in per_test.items():
            for b in by_bucket:
                unique_pb[b] += 1

        other_pb = {b: 0 for b in labels}
        # Count of DISTINCT other-tests with failures in each bucket — used to
        # adjust the "Unique flaky tests" line when the Other trace is hidden.
        other_unique_pb = {b: 0 for b in labels}
        for name in other_test_set:
            counts = per_test.get(name, {})
            for b, c in counts.items():
                other_pb[b] += c
                if c > 0:
                    other_unique_pb[b] += 1

        # Crash dumps per bucket: sum the per-build failed/passed/total split
        # over the builds that fall in each bucket.
        crash_failed_pb = {b: 0 for b in labels}
        crash_passed_pb = {b: 0 for b in labels}
        crash_total_pb = {b: 0 for b in labels}
        for r in results:
            cb = crash_per_build.get(r["build_id"])
            if not cb:
                continue
            b = run_bucket.get(r["build_id"])
            if b is None:
                continue
            crash_failed_pb[b] += cb["failed"]
            crash_passed_pb[b] += cb["passed"]
            crash_total_pb[b] += cb["total"]

        return {
            "bucket": bucket_kind,
            "labels": labels,
            "anchors": anchors,
            "anchors_iso": [a.strftime("%Y-%m-%d") for a in anchors],
            "per_test": {name: dict(per_test[name]) for name in per_test},
            "unique_per_bucket": unique_pb,
            "other_per_bucket": other_pb,
            "other_unique_per_bucket": other_unique_pb,
            "other_total": sum(other_pb.values()),
            "crash_failed_per_bucket": crash_failed_pb,
            "crash_passed_per_bucket": crash_passed_pb,
            "crash_total_per_bucket": crash_total_pb,
        }

    views = {
        "day": _compute_view("day"),
        "week": _compute_view("week"),
        "month": _compute_view("month"),
    }
    active_view = views[bucket]
    bucket_labels = active_view["labels"]
    bucket_anchors = active_view["anchors"]
    per_test_bucket_count = active_view["per_test"]
    unique_per_bucket = active_view["unique_per_bucket"]

    # tests_ranked retains the (name, by_bucket_for_active_view) shape used below.
    tests_ranked = [
        (name, per_test_bucket_count.get(name, {})) for name in tests_ranked_names
    ]

    # --- Build figure: 2 rows, shared x-axis, range slider on the bottom ---
    fig = make_subplots(
        rows=2, cols=1,
        shared_xaxes=False,
        row_heights=[0.4, 0.6],
        vertical_spacing=0.12,
        subplot_titles=(
            "Nightly Pass Rate (main)",
            f"Flaky Tests per {bucket.title()} — click test names in the legend to filter",
        ),
    )

    # Row 1: Pass rate line.
    fig.add_trace(
        go.Scatter(
            x=run_dates, y=pass_pcts,
            mode="lines+markers",
            name="Pass %",
            line=dict(color="#2ecc71", width=2),
            marker=dict(size=8),
            hovertext=hover_text,
            hoverinfo="text",
            customdata=build_urls,
            showlegend=False,
        ),
        row=1, col=1,
    )
    # Row 1 (overlay): light bar of failed counts so the eye picks up bad runs.
    fig.add_trace(
        go.Bar(
            x=run_dates, y=failed_counts,
            name="Failed tests",
            marker=dict(color="#e74c3c", opacity=0.25),
            yaxis="y3",
            hovertemplate="<b>%{x|%Y-%m-%d}</b><br>Failed: %{y}<extra></extra>",
            showlegend=False,
        ),
        row=1, col=1,
    )

    # Row 1 (trend): linear regression of pass-rate vs days-since-start. Tells
    # the reader at a glance whether the suite is drifting up or down.
    if len(results) >= 2:
        xs_days = [(r["date"] - results[0]["date"]).days for r in results]
        n = len(xs_days)
        mean_x = sum(xs_days) / n
        mean_y = sum(pass_pcts) / n
        num = sum((xs_days[i] - mean_x) * (pass_pcts[i] - mean_y) for i in range(n))
        den = sum((xs_days[i] - mean_x) ** 2 for i in range(n))
        if den > 0:
            slope = num / den           # %/day
            intercept = mean_y - slope * mean_x
            trend_y = [slope * x + intercept for x in xs_days]
            slope_label = f"{slope:+.3f}%/day"
            fig.add_trace(
                go.Scatter(
                    x=run_dates, y=trend_y,
                    mode="lines",
                    name=f"Pass-rate trend ({slope_label})",
                    line=dict(color="#888", width=2, dash="dash"),
                    hovertemplate=(
                        "<b>Pass-rate trend</b><br>%{x|%Y-%m-%d}<br>%{y:.2f}%"
