</div>
<p class="hint">Tip: click a single test in the legend to toggle it, double-click to isolate it. Bucket buttons filter to tests with failures in ANY selected bucket (combined with the text filter using AND). The "Other" rollup and the unique-count line are unaffected.</p>
__PLOT_DIV__
__CRASH_DIV__
__BRACKET_DIV__
__RESOLVED_DIV__
<script>
  const VIEWS = __VIEWS_PAYLOAD__;
  const BRACKETS = __BRACKETS_PAYLOAD__;
  const TEST_TOTALS = __TEST_TOTALS__;
  const TOP_TEST_NAMES = new Set(__TOP_TEST_NAMES__);
  let topNameTraceIdx = null;
  let currentView = __INITIAL_VIEW__;
  let BUCKETS = VIEWS[currentView].labels.map((label, i) => ({
    label, display: VIEWS[currentView].displays[i]
  }));
  const activeBuckets = new Set();

  function renderBucketButtons() {
    const row = document.getElementById('bucket-row');
    const clearBtn = document.getElementById('bucket-clear');
    // Remove existing bucket buttons (except the clear button and view toggle).
    row.querySelectorAll('button.bucket-btn').forEach(b => {
      if (b.id !== 'bucket-clear') b.remove();
    });
    BUCKETS.forEach(b => {
      const btn = document.createElement('button');
      btn.className = 'bucket-btn';
      btn.textContent = b.display;
      btn.dataset.bucket = b.label;
      btn.onclick = () => toggleBucket(b.label, btn);
      row.insertBefore(btn, clearBtn);
    });
  }

  function switchView(viewName) {
    if (viewName === currentView || !VIEWS[viewName]) return;
    currentView = viewName;
    const v = VIEWS[viewName];
    BUCKETS = v.labels.map((label, i) => ({ label, display: v.displays[i] }));
    activeBuckets.clear();

    const gd = document.getElementById('chart');
    const xVals = v.anchors_iso;

    // Batch all per-test updates into one Plotly.restyle call. With many
    // traces, per-trace restyles trigger N redraws — batched is N-times faster.
    const testIdxs = [];
    const testY = [];
    const testMeta = [];
    let otherIdx = -1, uniqueIdx = -1, filteredIdx = -1, flakyTrendIdx = -1;
    for (let i = 0; i < gd.data.length; i++) {
      const m = gd.data[i].meta;
      if (!m || !m.kind) continue;
      if (m.kind === 'test') {
        const counts = v.perTest[m.name] || {};
        const y = v.labels.map(l => counts[l] || 0);
        const buckets = v.labels.filter(l => (counts[l] || 0) > 0);
        testIdxs.push(i);
        testY.push(y);
        testMeta.push({ kind: 'test', name: m.name, buckets, total: m.total });
      } else if (m.kind === 'other') {
        otherIdx = i;
      } else if (m.kind === 'unique_line') {
        uniqueIdx = i;
      } else if (m.kind === 'filtered_line') {
        filteredIdx = i;
      } else if (m.kind === 'flaky_trend_line') {
        flakyTrendIdx = i;
      }
    }
    if (testIdxs.length) {
      // x is the same for every test trace; Plotly broadcasts a single x array
      // across all trace indices when only one entry is supplied.
      Plotly.restyle(gd, { x: [xVals], y: testY, meta: testMeta }, testIdxs);
    }
    if (otherIdx >= 0) {
      const y = v.labels.map(l => v.otherPerBucket[l] || 0);
      Plotly.restyle(gd, { x: [xVals], y: [y] }, [otherIdx]);
    }
    if (uniqueIdx >= 0) {
      const y = v.labels.map(l => v.uniquePerBucket[l] || 0);
      Plotly.restyle(gd, { x: [xVals], y: [y], text: [y.map(String)] }, [uniqueIdx]);
    }
    if (filteredIdx >= 0) {
      // y is recomputed below by updateFilteredLine via onFilterChanged.
      Plotly.restyle(gd, { x: [xVals] }, [filteredIdx]);
    }
    if (flakyTrendIdx >= 0) {
      // y is recomputed by updateFlakyTrendLine (chained off updateUniqueLine).
      Plotly.restyle(gd, { x: [xVals] }, [flakyTrendIdx]);
    }

    // Update subplot title and row-2 x-axis title.
    const titlePrefix = 'Flaky Tests per ';
    const viewLabel = viewName === 'day' ? 'Day'
                    : viewName === 'week' ? 'Week'
                    : 'Month';
    const newSubTitle = titlePrefix + viewLabel
      + ' — click test names in the legend to filter';
    const annotations = (gd.layout.annotations || []).map(a => {
      if (a && typeof a.text === 'string' && a.text.startsWith(titlePrefix)) {
        return Object.assign({}, a, { text: newSubTitle });
      }
      return a;
    });
    Plotly.relayout(gd, {
      annotations,
      'xaxis2.title.text': 'Bucket (' + viewName + ')',
    });

    // Bracket chart shares the bucket x-axis; switch its x values + axis title.
    const gdBr = document.getElementById('chart-brackets');
    if (gdBr && gdBr.data && BRACKETS && BRACKETS.length) {
      const idxs = BRACKETS.map((_, i) => i);
      Plotly.restyle(gdBr, { x: idxs.map(() => xVals) }, idxs);
      Plotly.relayout(gdBr, { 'xaxis.title.text': 'Bucket (' + viewName + ')' });
    }

    // Resolved chart: rebuild y values + visibility from the new view's data.
    const gdRes = document.getElementById('chart-resolved');
    if (gdRes && gdRes.data && gdRes.data.length) {
      const resolvedSet = new Set(v.resolvedTests || []);
      const resIdxs = [];
      const resX = [];
      const resY = [];
      const resVis = [];
      for (let i = 0; i < gdRes.data.length; i++) {
        const m = gdRes.data[i].meta;
        if (!m || m.kind !== 'resolved') continue;
        const counts = v.perTest[m.name] || {};
        resIdxs.push(i);
        resX.push(xVals);
        resY.push(v.labels.map(l => counts[l] || 0));
        resVis.push(resolvedSet.has(m.name) ? true : 'legendonly');
      }
      if (resIdxs.length) {
        Plotly.restyle(gdRes, { x: resX, y: resY, visible: resVis }, resIdxs);
        Plotly.relayout(gdRes, { 'xaxis.title.text': 'Bucket (' + viewName + ')' });
      }
    }

    // Crash chart: rebuild the failed/passed/total series for the new view.
    const gdCr = document.getElementById('chart-crashes');
    if (gdCr && gdCr.data && gdCr.data.length) {
      const crIdxs = [];
      const crX = [];
      const crY = [];
      const crText = [];
      for (let i = 0; i < gdCr.data.length; i++) {
        const m = gdCr.data[i].meta;
        if (!m || !m.kind) continue;
        let src = null;
        if (m.kind === 'crash_failed') src = v.crashFailedPerBucket;
        else if (m.kind === 'crash_passed') src = v.crashPassedPerBucket;
        if (!src) continue;
        const y = v.labels.map(l => src[l] || 0);
        crIdxs.push(i);
        crX.push(xVals);
        crY.push(y);
        crText.push(y.map(String));
      }
      if (crIdxs.length) {
        Plotly.restyle(gdCr, { x: crX, y: crY, text: crText }, crIdxs);
        Plotly.relayout(gdCr, { 'xaxis.title.text': 'Bucket (' + viewName + ')' });
      }
    }

    renderBucketButtons();
    updateViewToggleButtons();
    onFilterChanged();
  }

  function updateViewToggleButtons() {
    document.getElementById('vt-day').classList.toggle('active', currentView === 'day');
    document.getElementById('vt-week').classList.toggle('active', currentView === 'week');
    document.getElementById('vt-month').classList.toggle('active', currentView === 'month');
  }

  function toggleBucket(label, btn) {
    if (activeBuckets.has(label)) {
      activeBuckets.delete(label);
      btn.classList.remove('active');
    } else {
      activeBuckets.add(label);
      btn.classList.add('active');
    }
    applyFilter();
  }

  function clearBuckets() {
    activeBuckets.clear();
    document.querySelectorAll('.bucket-btn.active').forEach(b => b.classList.remove('active'));
    applyFilter();
  }

  function testIndices() {
    const gd = document.getElementById('chart');
    const idx = [];
    for (let i = 0; i < gd.data.length; i++) {
      const m = gd.data[i].meta;
      if (m && m.kind === 'test') idx.push(i);
    }
    return idx;
  }

  function setVisibility(visArray) {
    const gd = document.getElementById('chart');
    const idx = testIndices();
    Plotly.restyle(gd, { visible: visArray }, idx);
    onFilterChanged();
  }

  function applyFilter() {
    const q = document.getElementById('test-search').value.trim().toLowerCase();
    const gd = document.getElementById('chart');
    const idx = testIndices();
    const useBuckets = activeBuckets.size > 0;
    const vis = idx.map(i => {
      const trace = gd.data[i];
      // Text filter (AND).
      if (q !== '') {
        const name = (trace.name || '').toLowerCase();
        if (!name.includes(q)) return 'legendonly';
      }
      // Bucket filter (AND across the test-set; OR within active buckets).
      if (useBuckets) {
        const tBuckets = (trace.meta && trace.meta.buckets) || [];
        const hit = tBuckets.some(b => activeBuckets.has(b));
        if (!hit) return 'legendonly';
      }
      return true;
    });
    Plotly.restyle(gd, { visible: vis }, idx);
    onFilterChanged();
  }

  function showOnlyMatching() { applyFilter(); }

  function showAll() {
    document.getElementById('test-search').value = '';
    clearBuckets();
    const gd = document.getElementById('chart');
    const idx = testIndices();
    Plotly.restyle(gd, { visible: idx.map(() => true) }, idx);
    // Also un-hide Other so this is a true "show everything" reset.
    setOtherVisibility(true);
    // Defer for the same reason as hideOther/showOther.
    setTimeout(onFilterChanged, 0);
  }

  function hideAll() {
    const idx = testIndices();
    setVisibility(idx.map(() => 'legendonly'));
  }

  function hideSingletons() {
    // Hide tests that failed exactly once across the full date range.
    // Touches singletons only; leaves the visibility of other traces alone.
    const gd = document.getElementById('chart');
    const singletonIdx = testIndices().filter(i => {
      const m = gd.data[i].meta;
      return m && m.total === 1;
    });
    if (singletonIdx.length === 0) return;
    Plotly.restyle(gd, { visible: singletonIdx.map(() => 'legendonly') }, singletonIdx);
    setTimeout(onFilterChanged, 0);
  }

  function setOtherVisibility(visible) {
    const gd = document.getElementById('chart');
    for (let i = 0; i < gd.data.length; i++) {
      const m = gd.data[i].meta;
      if (m && m.kind === 'other') {
        Plotly.restyle(gd, { visible: visible ? true : 'legendonly' }, [i]);
        return;
      }
    }
  }

  function hideOther() {
    setOtherVisibility(false);
    // Defer so Plotly.restyle has finished propagating before we read
    // gd.data[i].visible in isOtherVisible() inside onFilterChanged.
    setTimeout(onFilterChanged, 0);
  }

  function showOther() {
    setOtherVisibility(true);
    setTimeout(onFilterChanged, 0);
  }

  function findTraceByKind(kind) {
    const gd = document.getElementById('chart');
    for (let i = 0; i < gd.data.length; i++) {
      const m = gd.data[i].meta;
      if (m && m.kind === kind) return i;
    }
    return -1;
  }

  function isOtherVisible() {
    const gd = document.getElementById('chart');
    for (let i = 0; i < gd.data.length; i++) {
      const m = gd.data[i].meta;
      if (m && m.kind === 'other') {
        const v = gd.data[i].visible;
        return v === true || v === undefined;
      }
    }
    return false;  // No Other trace exists.
  }

  function updateUniqueLine() {
    const gd = document.getElementById('chart');
    const idx = findTraceByKind('unique_line');
    if (idx < 0) return;
    const v = VIEWS[currentView];
    const otherVisible = isOtherVisible();
    const yValues = v.labels.map(label => {
      const base = v.uniquePerBucket[label] || 0;
      const otherUnique = (v.otherUniquePerBucket || {})[label] || 0;
      return otherVisible ? base : Math.max(0, base - otherUnique);
    });
    Plotly.restyle(gd, { y: [yValues], text: [yValues.map(String)] }, [idx]);
    // Follow the unique line with the flaky-test trend.
    updateFlakyTrendLine(yValues);
  }

  function computeTrendY(yValues) {
    const n = yValues.length;
    if (n < 2) return yValues.slice();
    const meanX = (n - 1) / 2;
    const meanY = yValues.reduce((a, b) => a + b, 0) / n;
    let num = 0, den = 0;
    for (let i = 0; i < n; i++) {
      const dx = i - meanX;
      num += dx * (yValues[i] - meanY);
      den += dx * dx;
    }
    if (den === 0) return yValues.slice();
    const slope = num / den;
    const intercept = meanY - slope * meanX;
    return Array.from({ length: n }, (_, i) => slope * i + intercept);
  }

  function updateFlakyTrendLine(yValues) {
    const gd = document.getElementById('chart');
    const idx = findTraceByKind('flaky_trend_line');
    if (idx < 0) return;
    Plotly.restyle(gd, { y: [computeTrendY(yValues)] }, [idx]);
  }

  function updateFilteredLine() {
    const gd = document.getElementById('chart');
    const filteredIdx = findTraceByKind('filtered_line');
    if (filteredIdx < 0) return;
    // Per-bucket count of currently-visible per-test traces that had failures there.
    const counts = {};
    for (const b of BUCKETS) counts[b.label] = 0;
    const idx = testIndices();
    for (const i of idx) {
      const v = gd.data[i].visible;
      const isVisible = (v === true || v === undefined);
      if (!isVisible) continue;
      const tBuckets = (gd.data[i].meta && gd.data[i].meta.buckets) || [];
      for (const b of tBuckets) {
        if (counts[b] !== undefined) counts[b]++;
      }
    }
    const yValues = BUCKETS.map(b => counts[b.label] || 0);
    const labels = yValues.map(v => String(v));
    Plotly.restyle(gd, { y: [yValues], text: [labels] }, [filteredIdx]);
  }

  function updateStats() {
    const gd = document.getElementById('chart');
    const idx = testIndices();
    let visible = 0;
    for (const i of idx) {
      const v = gd.data[i].visible;
      if (v === true || v === undefined) visible++;
    }
    document.getElementById('stats').textContent =
      'Showing ' + visible + ' / ' + idx.length + ' tests';
  }

  function buildTopNameMap() {
    const gd = document.getElementById('chart');
    topNameTraceIdx = {};
    for (let i = 0; i < gd.data.length; i++) {
      const m = gd.data[i].meta;
      if (m && m.kind === 'test') topNameTraceIdx[m.name] = i;
    }
  }

  function isTestVisible(name) {
    if (topNameTraceIdx === null) buildTopNameMap();
    const idx = topNameTraceIdx[name];
    if (idx !== undefined) {
      const v = document.getElementById('chart').data[idx].visible;
      return v === true || v === undefined;
    }
    // Tail test (not in top-N) — inherits Other rollup visibility.
    return isOtherVisible();
  }

  function updateBracketChart() {
    if (!BRACKETS || BRACKETS.length === 0) return;
    const gdBr = document.getElementById('chart-brackets');
    if (!gdBr || !gdBr.data) return;
    const v = VIEWS[currentView];
    const yArrays = BRACKETS.map(() => v.labels.map(() => 0));
    for (const name in v.perTest) {
      if (!isTestVisible(name)) continue;
      const total = TEST_TOTALS[name];
      if (total === undefined) continue;
      let bi = -1;
      for (let i = 0; i < BRACKETS.length; i++) {
        if (BRACKETS[i].lo <= total && total <= BRACKETS[i].hi) {
          bi = i;
          break;
        }
      }
      if (bi < 0) continue;
      const counts = v.perTest[name];
      for (let i = 0; i < v.labels.length; i++) {
        yArrays[bi][i] += counts[v.labels[i]] || 0;
      }
    }
    const idxs = BRACKETS.map((_, i) => i);
    Plotly.restyle(gdBr, { y: yArrays }, idxs);
  }

  function onFilterChanged() {
    updateStats();
    updateFilteredLine();
    updateUniqueLine();
    updateBracketChart();
  }

  renderBucketButtons();
  updateViewToggleButtons();
  // Initial render + listen for Plotly legend clicks so the filtered line and
  // counter stay in sync when the user toggles tests via the legend. Do NOT
  // listen to plotly_restyle — our own updateFilteredLine() calls Plotly.restyle
  // and would recurse infinitely.
  setTimeout(() => {
    const gd = document.getElementById('chart');
    onFilterChanged();
    if (gd && gd.on) {
      // setTimeout(...,0) defers until after Plotly applies the toggle so the
      // visibility state we read is fresh.
      gd.on('plotly_legendclick', () => { setTimeout(onFilterChanged, 0); });
      gd.on('plotly_legenddoubleclick', () => { setTimeout(onFilterChanged, 0); });
    }
  }, 50);
</script>
</body>
</html>
