    if min_failures > 1:
        dropped_min = (
            original_test_count - len(tests_ranked)
            - len(dropped_broken_names) - len(excluded_by_prefix)
        )
        filter_notes.append(f"dropped {dropped_min} below {min_failures}-failure threshold")
    if filter_notes:
        print(f"  Unique flaky tests: {len(tests_ranked)} "
              f"({'; '.join(filter_notes)})", file=sys.stderr)
    else:
        print(f"  Unique flaky tests: {len(tests_ranked)}", file=sys.stderr)
    if other_tests:
        print(f"  Shown individually: {len(top_tests)} (top {top_n}); "
              f"{len(other_tests)} rolled into 'Other'", file=sys.stderr)


def display_results(results: List[Dict[str, Any]]) -> None:
    """Print numbered list of runs with pass/fail data for user review."""
    print(f"\nFound {len(results)} run(s):\n", file=sys.stderr)
    print(f"  {'#':<4} {'Date':<12} {'Pass%':>6} {'Passed':>7} {'Failed':>7} {'Total':>7}",
          file=sys.stderr)
    print(f"  {'---':<4} {'----------':<12} {'-----':>6} {'------':>7} {'------':>7} {'-----':>7}",
          file=sys.stderr)
    for i, r in enumerate(results, 1):
        date_str = r["date"].strftime("%Y-%m-%d")
        print(f"  {i:<4} {date_str:<12} {r['pass_pct']:>5.1f}% {r['passed']:>7} "
              f"{r['failed']:>7} {r['total']:>7}", file=sys.stderr)
    print(file=sys.stderr)


def prompt_omit(results: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Prompt user to omit runs by number. Returns filtered list."""
    try:
        response = input("Runs to omit (e.g. 2,5 or blank for none): ").strip()
    except EOFError:
        # Non-interactive shell — treat as "no omissions".
        print("(no stdin — keeping all runs)", file=sys.stderr)
        return results
    if not response:
        return results

    omit_indices = set()
    for part in response.split(","):
        part = part.strip()
        if part.isdigit():
            idx = int(part)
            if 1 <= idx <= len(results):
                omit_indices.add(idx)
            else:
                print(f"  Warning: #{idx} is out of range, ignoring.", file=sys.stderr)

    filtered = [r for i, r in enumerate(results, 1) if i not in omit_indices]
    omitted_count = len(results) - len(filtered)
    if omitted_count:
        print(f"  Omitted {omitted_count} run(s), {len(filtered)} remaining.\n",
              file=sys.stderr)
    return filtered


def main():
    parser = argparse.ArgumentParser(
        description="Graph nightly Run Regression pass rates from portal.btrusteng.com"
    )
    parser.add_argument("output", nargs="?", default=None,
                        help="Output path. Default: regression-trend.png (or .html with --interactive)")
    parser.add_argument("--flakey", action="store_true",
                        help="Identify flakey tests by failure frequency and write flakey.md")
    parser.add_argument("--interactive", action="store_true",
                        help="Produce an interactive Plotly HTML report with flake "
                             "counts bucketed over time (toggle tests, range slider).")
    parser.add_argument("--bucket", choices=["day", "week", "month"], default=None,
                        help="Time bucket for the interactive flake chart "
                             "(day / week / month). Default: week.")
    parser.add_argument("--weeks", type=int, default=4,
                        help="Number of weeks to look back (default: 4)")
    parser.add_argument("--days", type=int, default=None,
                        help="Number of days to look back. Overrides --weeks if "
                             "given. Useful for non-week-multiple windows (e.g. "
                             "--days 10).")
    parser.add_argument("--fulldetail", type=int, default=20,
                        help="Number of top failures to show with full links (default: 20)")
    parser.add_argument("--top", type=int, default=30,
                        help="Interactive chart: show only the top N flakiest tests "
                             "individually; aggregate the rest as 'Other' (default: 30). "
                             "Use 0 for no cap.")
    parser.add_argument("--min-failures", type=int, default=1,
                        help="Interactive chart: only include tests that failed at "
                             "least N times across the window (default: 1 = include "
                             "all). Use 2 to drop singleton failures entirely.")
    parser.add_argument("--max-failure-rate", type=float, default=0.95,
                        help="Interactive chart: exclude tests whose failure_rate "
                             "(failures / total_runs) is >= this threshold (default: "
                             "0.95). Used to filter out consistently-broken tests. "
                             "Use 1.0 to disable.")
    parser.add_argument("--min-pass-rate", type=float, default=0.0,
                        help="Drop runs whose overall pass rate is below this "
                             "fraction (default: 0.0 = no filter). Use e.g. 0.95 "
                             "to exclude obviously broken runs (infrastructure "
                             "failures, partial runs) before flakiness is computed.")
    parser.add_argument("--exclude-prefix", action="append", default=[],
                        metavar="PREFIX",
                        help="Drop tests whose name starts with PREFIX. Repeatable "
                             "for multiple prefixes (e.g. --exclude-prefix REFS_ "
                             "--exclude-prefix MANUAL_).")
    parser.add_argument("--exclude-suite", action="append", default=[],
                        metavar="SUBSTR",
                        help="Drop individual failures whose suite "
                             "(executionDefinition) contains SUBSTR "
                             "(case-insensitive). Repeatable. Example: "
                             "--exclude-suite ARM64 to drop ARM64-only failures.")
    parser.add_argument("--portal-url", default=os.getenv("PORTAL_URL", DEFAULT_PORTAL_URL),
                        help=f"DevOps Portal base URL (default: {DEFAULT_PORTAL_URL})")
    parser.add_argument("--repo", default=os.getenv("PORTAL_REPO", DEFAULT_REPO),
                        help=f"Repo name in the portal (default: {DEFAULT_REPO})")
    parser.add_argument("--workflow", default=os.getenv("PORTAL_WORKFLOW", DEFAULT_WORKFLOW),
                        help=f"Workflow name (default: {DEFAULT_WORKFLOW!r})")
    parser.add_argument("--branch", default=os.getenv("PORTAL_BRANCH", DEFAULT_BRANCH),
                        help=f"Branch filter (default: {DEFAULT_BRANCH})")
    args = parser.parse_args()

    # Suppress urllib3 self-signed-cert warnings since we set verify=False.
    try:
        from urllib3.exceptions import InsecureRequestWarning
        requests.packages.urllib3.disable_warnings(InsecureRequestWarning)
    except Exception:
        pass

    conn = PortalConnection(
        portal_url=args.portal_url,
        repo=args.repo,
        workflow=args.workflow,
        branch=args.branch,
    )

    # --days overrides --weeks when set; both end up as a day-count for the API
    # and a human-readable duration label for the report.
    if args.days is not None:
        if args.days <= 0:
            parser.error("--days must be a positive integer")
        lookback_days = args.days
        duration_label = f"{lookback_days} day{'s' if lookback_days != 1 else ''}"
    else:
        lookback_days = args.weeks * 7
        duration_label = f"{args.weeks} week{'s' if args.weeks != 1 else ''}"

    results = collect_data(conn, days=lookback_days)
    if not results:
        print("No regression runs found.", file=sys.stderr)
        return

    # Drop runs with a low overall pass rate (infrastructure failures / partials)
    # before display so the user sees what they're working with.
    if args.min_pass_rate > 0:
        threshold_pct = args.min_pass_rate * 100
        before_count = len(results)
        results = [r for r in results if r["pass_pct"] >= threshold_pct]
        dropped = before_count - len(results)
        if dropped:
            print(f"Dropped {dropped} run(s) below {threshold_pct:.1f}% pass rate "
                  f"(--min-pass-rate).", file=sys.stderr)
        if not results:
            print("All runs filtered out by --min-pass-rate.", file=sys.stderr)
            return

    display_results(results)
    results = prompt_omit(results)

    if not results:
        print("All runs omitted, nothing to do.", file=sys.stderr)
        return

    if args.interactive:
        bucket = args.bucket or "week"
        output = args.output or "regression-trend.html"
        if args.top and args.top > 100:
            print(f"  Warning: --top {args.top} produces {args.top} stacked bar "
                  "traces; Plotly rendering may freeze the browser. "
                  "50–75 is the practical limit; 100 is the sane ceiling.",
                  file=sys.stderr)
        failure_map, crash_per_build = fetch_failure_map(conn, results)
        if not failure_map:
            print("No failed tests found across the selected runs.", file=sys.stderr)
        generate_interactive_html(
            conn, results, failure_map,
            output_path=output, duration_label=duration_label, bucket=bucket,
            top_n=args.top, min_failures=args.min_failures,
            max_failure_rate=args.max_failure_rate,
            min_pass_rate=args.min_pass_rate,
            exclude_prefixes=args.exclude_prefix,
            exclude_suite_substrings=args.exclude_suite,
            crash_per_build=crash_per_build,
        )
    elif args.flakey:
        collect_flakey_data(conn, results, full_detail=args.fulldetail)
    else:
        print_table(results)
        generate_chart(results, args.output or "regression-trend.png",
                       duration_label=duration_label)


if __name__ == "__main__":
    main()
