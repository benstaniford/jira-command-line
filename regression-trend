    # --- Second chart: Failures grouped by failure-count bracket ---
    # Lines: one per bracket (5-9, 10-14, 15-19, ...). For each bucket on the
    # x-axis, each line shows the total failures contributed by tests whose
    # TOTAL failure count across the window falls in that bracket. Dynamic —
    # updates to mirror the main chart's filters via JS.
    max_total = max(test_totals.values()) if test_totals else 0
    brackets_defs = []
    _br_lo, _br_step = 5, 5
    while _br_lo <= max_total:
        _br_hi = _br_lo + _br_step - 1
        if _br_hi >= max_total:
            label = str(_br_lo) if _br_lo == max_total else f"{_br_lo}-{max_total}"
            brackets_defs.append({"lo": _br_lo, "hi": max_total, "label": label})
            break
        brackets_defs.append({
            "lo": _br_lo, "hi": _br_hi, "label": f"{_br_lo}-{_br_hi}"
        })
        _br_lo += _br_step
    for _br in brackets_defs:
        _br["test_count"] = sum(
            1 for t in test_totals.values() if _br["lo"] <= t <= _br["hi"]
        )

    def _bracket_y(view: Dict[str, Any], br: Dict[str, Any]) -> List[int]:
        labels = view["labels"]
        by_bucket = {b: 0 for b in labels}
        for name, total in test_totals.items():
            if not (br["lo"] <= total <= br["hi"]):
                continue
            for b, c in view["per_test"].get(name, {}).items():
                if b in by_bucket:
                    by_bucket[b] += c
        return [by_bucket[b] for b in labels]

    # --- Resolved-tests chart: tests with no failures in the last K buckets ---
    # A test is "resolved" if it had failures earlier in the window but stopped
    # — quiet for the last K buckets. Each line shows its failure trajectory so
    # the resolution point (where it hits zero) is visually obvious.
    K_RESOLVED = 2

    def _is_resolved(counts: Dict[str, int], labels: List[str]) -> bool:
        if len(labels) < K_RESOLVED + 1:
            return False
        recent = labels[-K_RESOLVED:]
        earlier = labels[:-K_RESOLVED]
        if any(counts.get(b, 0) > 0 for b in recent):
            return False
        return any(counts.get(b, 0) > 0 for b in earlier)

    resolved_per_view: Dict[str, List[str]] = {}
