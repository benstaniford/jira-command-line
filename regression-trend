    else:
        _exclude_desc = "none"
    if exclude_suite_substrings:
        _suite_html = ", ".join(
            f"<code>{_esc(s)}</code>" for s in exclude_suite_substrings
        )
        _suite_desc = (
            f"{_suite_html} "
            f"(dropped {dropped_suite_occurrences} failure occurrence"
            f"{'s' if dropped_suite_occurrences != 1 else ''}"
            f"; {dropped_suite_tests} test"
            f"{'s' if dropped_suite_tests != 1 else ''} entirely)"
        )
    else:
        _suite_desc = "none"
    meta_rows = [
        ("Source",
         f"{_esc(conn.repo)} / {_esc(conn.branch)} / "
         f"workflow “{_esc(conn.workflow)}”"),
        ("Date range",
         f"{_esc(_date_start)} → {_esc(_date_end)} "
         f"({len(results)} runs over {_esc(duration_label)})"),
        ("Bucket", _esc(bucket) + " (toggleable in UI)"),
        ("Run pass-rate filter", _min_pass_desc),
        ("Suite exclusions", _suite_desc),
        ("Name-prefix exclusions", _exclude_desc),
        ("Flaky-test definition", _flaky_def_html),
        ("Max failure-rate filter", _broken_desc),
        ("Minimum failures filter",
         _esc(_min_fail_desc)
         + (f" (dropped {original_test_count - len(test_totals) - len(dropped_broken_names) - len(excluded_by_prefix)}"
            f" tests below threshold)" if min_failures > 1 else "")),
        ("Per-test cap (--top)",
         _esc(_top_desc)
         + f"; {len(top_test_names)} individual traces"
         + (f" + {len(other_test_names)} rolled into Other" if other_test_names else "")),
        ("Total qualifying tests",
         f"{len(test_totals)} (of {original_test_count} that ever failed)"),
    ]
    meta_html_rows = "".join(
        f'<dt>{_esc(label)}</dt><dd>{value}</dd>' for label, value in meta_rows
    )
    meta_html = (
        '<details class="meta-panel" open>'
        '<summary>Report parameters &amp; definitions</summary>'
